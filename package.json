{
  "name": "abx",
  "version": "1.1.0",
  "description": "AbuseMan extension CLI: create, build, lint, pack, verify, keygen, dev, publish",
  "type": "module",
  "license": "MIT",
  "bin": {
    "abx": "./bin/abx.js",
    "create-abuseman-extension": "./bin/create-abuseman-extension.js"
  },
  "exports": {
    ".": { "types": "./src/index.ts", "bun": "./src/index.ts", "default": "./dist/index.js" }
  },
  "files": ["bin", "dist", "template", "sdk"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@abuseman/schemas": "workspace:*",
    "@types/bun": "^1.4.2",
    "fflate": "^0.8.3",
    "typescript": "^5.9.0"
  }
}
